# ── VCS y entornos locales ────────────────────────────────────────────────────
.git/
.github/
.claude/
venv/
.venv/

# ── Python cache y artefactos de build ───────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/

# ── Frontend: node_modules pesados se instalan en el stage frontend-builder ──
frontend/node_modules/
# dist/  ← NO excluir: el frontend-builder la produce dentro de su stage

# ── Herramientas de desarrollo (no van al runtime) ───────────────────────────
.pytest_cache/
tests/
scripts/
notebooks/
docs/

# ── Secrets y configuración local ────────────────────────────────────────────
.env
.env.*
# .env.example SÍ se incluye (no contiene secretos reales)
!.env.example

# ── Datos generados / volúmenes ───────────────────────────────────────────────
chroma_db/
experiments/

# ── Dependencias de desarrollo (no se instalan en la imagen) ─────────────────
requirements-dev.txt

# ── Docs del proyecto (no necesarios en runtime) ─────────────────────────────
# NOTA: *.md aplica solo al nivel raíz en Docker — corpus/*.md quedan incluidos
README.md
CHANGELOG.md
CONTRIBUTING.md

# ── Mockup y assets de diseño (solo para referencia visual) ──────────────────
mockup/

# ── Frontend legacy (vanilla JS anterior — no usado en build React) ───────────
frontend/js/
frontend/css/styles.css

# ── Logs y temporales ────────────────────────────────────────────────────────
*.log
*.tmp
.DS_Store
Thumbs.db
